# Production Environment Variables for Render Deployment
# Copy these to your Render dashboard environment variables

# Core API Configuration
ENVIRONMENT=production
PORT=10000
DEMO_MODE=false

# OpenAI Configuration (Required for Email Intelligence)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AWS SES + S3 Configuration (Required for Email Intelligence)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
SES_REGION=us-east-1
S3_BUCKET_NAME=coogi-email-storage
COOGI_DOMAIN=coogi.com

# Optional API Keys (for additional features)
HUNTER_API_KEY=your_hunter_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
INSTANTLY_API_KEY=your_instantly_api_key_here
