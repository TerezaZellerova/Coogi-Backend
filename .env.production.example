# Production Environment Variables for Render Deployment
# Copy these to your Render dashboard environment variables

# Core Server Configuration
ENVIRONMENT=production
PORT=10000
DEMO_MODE=false
RATE_LIMIT_PER_MIN=30

# OpenAI Configuration (Required for Email Intelligence)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Database Configuration (Required)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AWS SES & S3 Configuration (Required for Email Intelligence)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=your_aws_access_key_here
SES_SECRET_ACCESS_KEY=your_aws_secret_key_here
SES_FROM_EMAIL=noreply@coogi.ai
SES_FROM_NAME=COOGI Team
S3_BUCKET_NAME=coogi-email-intelligence
S3_BUCKET_REGION=us-east-1

# External API Keys (Optional but recommended)
HUNTER_API_KEY=your_hunter_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
APIFY_API_KEY=your_apify_api_key_here
CLEAROUT_API_KEY=your_clearout_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here

# Campaign Tracking URLs (Updated with your domains)
OPEN_TRACKING_BASE_URL=https://coogi-backend-7yca.onrender.com/api/campaigns/trk
UNSUBSCRIBE_BASE_URL=https://coogi.com/unsubscribe
